{
  "name": "pulsestock-ticker",
  "version": "1.0.0",
  "description": "PulseStock Desktop Ticker Bar",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-mac": "electron-builder --mac --x64",
    "build-mac-arm": "electron-builder --mac --arm64"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.pulsestock.ticker",
    "productName": "PulseStock",
    "copyright": "Copyright © 2024 PulseStock",
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        { "target": "dmg", "arch": ["x64"] }
      ],
      "icon": "assets/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "PulseStock Ticker",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "files": [
      "main.js",
      "ticker.html",
      "preload.js",
      "preload-login.js",
      "login.html",
      "permission.html",
      "assets/**"
    ],
    "extraResources": [],
    "asar": true
  }
}
